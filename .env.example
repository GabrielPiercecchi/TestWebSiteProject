SECRET_KEY=replace-with-a-long-random-value
POSTGRES_DB=hotel
POSTGRES_USER=hotel
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://hotel:change-this-password@db:5432/hotel
ADMIN_EMAIL=admin@gabriels-hotel.local
# Password iniziale usata solo per creare l'account demo; nel database viene salvato solo l'hash.
ADMIN_PASSWORD=change-this-admin-password
STAFF_EMAIL=staff@gabriels-hotel.local
# Password iniziale usata solo per creare l'account demo; nel database viene salvato solo l'hash.
STAFF_PASSWORD=change-this-staff-password
DEMO_USER_EMAIL=ospite@gabriels-hotel.local
# Password iniziale usata solo per creare l'account demo; nel database viene salvato solo l'hash.
DEMO_USER_PASSWORD=change-this-guest-password
TRUSTED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=0
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Brevo SMTP: smtp-relay.brevo.com
MAIL_SERVER=
MAIL_PORT=587
# Username: email usata per l'account Brevo
MAIL_USERNAME=
# Password: SMTP key Brevo, non la password dell'account
MAIL_PASSWORD=
MAIL_USE_TLS=1
# Deve essere un mittente verificato su Brevo
MAIL_FROM=noreply@dominio-verificato.example
